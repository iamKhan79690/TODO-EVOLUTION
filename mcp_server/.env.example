# MCP Server Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://user:password@neon.tech/dbname

# Authentication (must match FastAPI backend)
JWT_SECRET=your-jwt-secret-key-here
JWT_ALGORITHM=RS256

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8050
TRANSPORT=stdio

# Performance Tuning
MAX_CONCURRENT_TOOLS=100
CONNECTION_POOL_SIZE=20
CONNECTION_POOL_MAX_OVERFLOW=30
CACHE_TTL=300

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development
DEBUG=false
ENVIRONMENT=production

# Optional Redis for Caching (uncomment if using Redis)
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=your-redis-password

# Monitoring (optional)
# PROMETHEUS_PORT=9090
# SENTRY_DSN=your-sentry-dsn