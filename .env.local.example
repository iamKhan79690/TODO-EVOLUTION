# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# =============================================================================

# Copy this file to .env.local and update with your local values
# This file should NOT be committed to version control

# =============================================================================
# REQUIRED: Update these values for your local setup
# =============================================================================

# Database Configuration
# Get your connection string from Neon Tech dashboard
DATABASE_URL=postgresql://your-username:your-password@ep-xyz.us-east-2.aws.neon.tech/your-dbname?sslmode=require

# Authentication Configuration
# Generate a secure secret key: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-32-character-secret-key-here

# =============================================================================
# OPTIONAL: Usually fine with defaults for local development
# =============================================================================

# Frontend Configuration
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SIGN_IN_URL=/sign-in
BETTER_AUTH_SIGN_OUT_URL=/

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development

# Security Settings
CORS_ORIGINS=http://localhost:3000

# Database Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# JWT Settings
JWT_SECRET=another-secure-secret-key-for-jwt
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this template to .env.local:
#    cp .env.local.example .env.local

# 2. Update DATABASE_URL with your Neon PostgreSQL connection string

# 3. Generate secure secrets:
#    BETTER_AUTH_SECRET: openssl rand -base64 32
#    JWT_SECRET: openssl rand -base64 32

# 4. Save the file and run: npm run setup