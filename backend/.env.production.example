# Production Environment Variables for Render
# Copy these to Render's Environment section

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require
DATABASE_URL_ASYNC=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?ssl=require

# Authentication Secrets (GENERATE NEW ONES FOR PRODUCTION!)
# Use: openssl rand -base64 32
BETTER_AUTH_SECRET=GENERATE_NEW_SECRET_FOR_PRODUCTION
JWT_SECRET=GENERATE_NEW_SECRET_FOR_PRODUCTION

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# CORS (Update with your Vercel URL after deploying frontend)
CORS_ORIGINS=https://your-app.vercel.app

# Redis (Disabled - using in-memory for free tier)
REDIS_ENABLED=False

# Environment
ENVIRONMENT=production
